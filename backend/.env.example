# Server Configuration
PORT=8080
ENV=development

# Database Configuration (PostgreSQL with pgx)
DATABASE_URL=postgres://spendle:spendle@localhost:5432/spendle_db?sslmode=disable

# Authentication (JWT Secret Key)
JWT_SECRET=spendle-super-secret-dev-key-change-in-production

# CORS / Frontend Allowed Origin
FRONTEND_ORIGIN=http://localhost:5173

# Background Worker Interval (Go duration string: e.g. 1h; set to 10s for live demos)
WORKER_INTERVAL=1h
