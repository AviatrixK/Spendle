# Server Configuration
PORT=8080
ENV=development

# Database Configuration (PostgreSQL with pgx)
DATABASE_URL=postgres://spendle:spendle@localhost:5432/spendle_db?sslmode=disable

# Authentication (JWT Secret Key - minimum 32 characters)
JWT_SECRET=spendle-super-secret-dev-key-change-in-production

# CORS / Frontend Allowed Origin
FRONTEND_ORIGIN=http://localhost:5173

# Background Worker Interval (Go duration string: e.g. 1h; set to 10s for live demos)
WORKER_INTERVAL=1h

# Brevo Transactional Email Configuration
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=happyquinn4444@gmail.com
BREVO_SENDER_NAME=Spendle

# OTP Security Parameters
OTP_LENGTH=4
OTP_EXPIRY_MINUTES=2
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

# Optional: Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
